# ==============================================================================
# CarePilot-AI Production Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual production values.
# NEVER commit real credentials, API tokens, or secrets to version control.

# --- Core Application & Security ---
ENVIRONMENT=production
DEBUG=false
# Generate a strong 32-byte secret key with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_cryptographically_secure_random_key_in_production
PORT=8000

# --- Database (PostgreSQL recommended for production) ---
POSTGRES_USER=carepilot
POSTGRES_PASSWORD=change_this_to_a_secure_postgres_password
POSTGRES_DB=carepilot_db
DATABASE_URL=postgresql://carepilot:change_this_to_a_secure_postgres_password@db:5432/carepilot_db

# --- CORS Allowed Origins ---
# Comma-separated or JSON list of authorized frontend origins
BACKEND_CORS_ORIGINS=["http://localhost","http://localhost:80","http://localhost:3000","https://carepilot-frontend.onrender.com"]

# --- SMS Reminders Gateway (Twilio / Mock) ---
# Set to 'twilio' for live SMS delivery, or 'mock' for simulated in-memory delivery
SMS_PROVIDER=twilio
SMS_DEV_MODE=false
TWILIO_ACCOUNT_SID=AC_YOUR_TWILIO_ACCOUNT_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MG_YOUR_MESSAGING_SERVICE_SID_IF_APPLICABLE
TWILIO_TRIAL_MODE=true
TWILIO_TRIAL_TEMPLATE=sms_appointment_reminders

# --- AI & Voice Services (Optional / As needed) ---
MURF_API_KEY=your_murf_voice_ai_key_here
TAVILY_API_KEY=your_tavily_search_api_key_here
UNITY_AR_URL=
N8N_WEBHOOK_URL=

# --- Frontend Build Configuration ---
# Leave blank to use relative /api/v1 (automatic via Docker Nginx reverse proxy),
# or specify the public URL of your deployed backend (e.g., https://carepilot-backend.onrender.com)
VITE_API_BASE_URL=
