# ==========================================
# CarePilot AI — Backend Configuration (FastAPI)
# ==========================================

# Application
PROJECT_NAME="CarePilot AI Backend"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"

# Security & JWT (Replace with strong random 256-bit secret in production)
SECRET_KEY="replace_with_a_secure_jwt_secret_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local development default: SQLite
DATABASE_URL="sqlite:///./carepilot.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://carepilot_user:password@localhost:5432/carepilot_db"

# Allowed CORS Origins (Comma-separated or JSON list)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# Upload and Storage Limits
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_BYTES=10485760

# Optional Integrations
UNITY_AR_URL=""
N8N_WEBHOOK_URL=""
