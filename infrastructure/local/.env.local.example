# ==============================================================================
# CarePilot-AI Local Environment Variables Template
# ==============================================================================
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=local_development_secret_key_12345
PORT=8000

# SQLite default for rapid local development without Postgres
DATABASE_URL=sqlite:///./carepilot.db

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

SMS_PROVIDER=mock
SMS_DEV_MODE=true
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_TRIAL_MODE=true
TWILIO_TRIAL_TEMPLATE=sms_appointment_reminders

MURF_API_KEY=
TAVILY_API_KEY=
UNITY_AR_URL=
N8N_WEBHOOK_URL=

VITE_API_BASE_URL=http://localhost:8000/api/v1
